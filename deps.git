# NOTE: ember deps ARE inherited, other flavours deps are NOT. Mess reads exactly two dep lists: this file (which install.sh copies to config/current_flavour/) and the base ember one (config/deps.*, linked in for every flavour) — so anything ember already provides is available here for free.
# But a PARENT flavour contributes no deps: its installer only copies config/, migrations and templates. So every dep that community adds ON TOP of ember and that this flavour wants must be repeated below.

community = "https://github.com/bonfire-networks/community"

bonfire_api_graphql = "https://github.com/bonfire-networks/bonfire_api_graphql"

# bonfire_pages = "https://github.com/bonfire-networks/bonfire_pages"
bonfire_classify = "https://github.com/bonfire-networks/bonfire_classify"

# bonfire_quantify = "https://github.com/bonfire-networks/bonfire_quantify"

# bonfire_geolocate = "https://github.com/bonfire-networks/bonfire_geolocate"
bonfire_valueflows = "https://github.com/bonfire-networks/bonfire_valueflows"
bonfire_ui_valueflows = "https://github.com/bonfire-networks/bonfire_ui_valueflows"
bonfire_ui_kanban = "https://github.com/bonfire-networks/bonfire_ui_kanban"
bonfire_ui_coordination = "https://github.com/bonfire-networks/bonfire_ui_coordination"

# bonfire_breadpub = "https://github.com/bonfire-networks/bonfire_breadpub"

# bonfire_ui_reflow = "https://github.com/bonfire-networks/bonfire_ui_reflow"

# bonfire_recyclapp = "https://github.com/bonfire-networks/bonfire_recyclapp"

# bonfire_taxonomy_seeder = "https://github.com/bonfire-networks/bonfire_taxonomy_seeder"

# bonfire_valueflows_observe = "https://github.com/bonfire-networks/bonfire_valueflows_observe"
absinthe_client = "https://github.com/bonfire-networks/absinthe_client"
towel = "https://github.com/CyrusOfEden/towel"

